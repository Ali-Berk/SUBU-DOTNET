@model _23210201041___Ali_Berk_Ertemür.Models.TableSlider
@{
    ViewBag.Title = "UpdateSlider";
    Layout = "~/Views/Shared/_LayoutProfile.cshtml";
}
<div class="card d-flex justify-content-center" style="height:80vh">
    @using (Html.BeginForm("UpdateSlider", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken();
        <div class="card-header">
            <h2>Veri Düzenleme İşlemi</h2>
            @Html.HiddenFor(m => m.SliderId)
        </div>
        <div class="form-group card-body">
            <div>
                <label>Yeni Url giriniz.</label>
                @Html.TextBoxFor(model => model.SliderLink, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SliderLink, "", new { @class = "text-danger" })
            </div>
            <div><button type="submit" class="btn btn-success btn-block">Url kaydını düzenle</button></div>
        </div>
    }
</div>