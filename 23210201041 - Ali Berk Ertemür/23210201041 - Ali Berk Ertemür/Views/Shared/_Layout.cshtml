<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Bilecik</title>
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="~/Scripts/modernizr-2.6.2.js"></script>
    <link href="@if(ViewBag.Stylesheet != null) { @Url.Content(ViewBag.Stylesheet)}" rel="stylesheet" />
    <style>
        footer > * {
            margin: 0px;
        }

        body {
            height: 100vh;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand navbar-light bg-light fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand">Ali Berk</a>
            <ul class="navbar-nav ms-auto ">
                <li class="nav-item me-4">@Html.ActionLink("Oturum aç","Login","Home",  new {@class ="btn nav-link"})</li>
                <li class="nav-item me-4">@Html.ActionLink("Kayıt Ol", "Register", "Home", new { @class = "btn nav-link" })</li>
            </ul>

        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Ali Berk Ertemür tarafından Yapılmıştır</p>
            <p>Sakarya Uygulamalı Bilimler Üniversitesi - Bilgisayar Programcılığı I.Ö</p>
            <p>İnternet Programcılığı II dersi dönem ödevi</p>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="@if (ViewBag.Script != null) { @Url.Content(ViewBag.Script)} "></script>
</body>
</html>